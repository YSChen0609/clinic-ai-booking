# Copy to .env and adjust locally. Do not commit .env.
# Compose reads this file for ${VAR} substitution. It is not mounted into containers.

APP_IMAGE_TAG=0.1.0
APP_PORT=8000
# Host port for Postgres. Change if 5432 is already in use (e.g. 5433).
POSTGRES_PORT=5432
OLLAMA_PORT=11434
# Tool-capable Ollama tag used by the chat agent (pull after compose up).
OLLAMA_MODEL=qwen2.5:7b
# GPU: use compose.gpu.yml on a ready NVIDIA host (see docs/host-requirements.md).
# Optional: point app at host Ollama instead of the compose service, e.g.:
# OLLAMA_BASE_URL=http://host.docker.internal:11434

# Voicebox (faster-whisper STT + Piper TTS). App reaches it as http://voice:8790 in Compose.
VOICE_PORT=8790
VOICE_ENABLED=true
# OpenAI-shaped model id for /v1/audio/transcriptions (Voicebox alias).
VOICE_STT_MODEL=stt
VOICE_TTS_VOICE=en_US-amy-medium
# VOICEBOX_CPU_THREADS=4
# Underlying STT in the image: Systran/faster-distil-whisper-small.en (~0.5–1 GiB RAM).

POSTGRES_USER=clinic
POSTGRES_PASSWORD=clinic_dev_change_me
POSTGRES_DB=clinic

TZ=Asia/Taipei

# Signed session cookie (change for anything beyond local demo).
# SESSION_SECRET=replace-me

# Host pytest uses clinic_test on this host/port (Compose app uses hostname `db` instead).
# TEST_DATABASE_URL=postgresql+psycopg://clinic:clinic_dev_change_me@localhost:5432/clinic_test

# --- Stage 6: clinic Google Calendar + Outlook (calendar + email) ---
# Default stays fake. Set NOTIFY_MODE=real and fill credentials for a live demo.
# No patient OAuth — clinic account creates events with the patient as attendee + sends mail.
NOTIFY_MODE=fake
# EMAIL_PROVIDER=auto|google|outlook|both  (auto prefers Outlook when both are ready)
EMAIL_PROVIDER=auto

# How to obtain these values: see docs/oauth-setup.md
# Google (OAuth refresh token for the shared clinic calendar / Gmail sender)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=
# GOOGLE_CALENDAR_ID=primary
# GOOGLE_SENDER=clinic@example.com

# Microsoft Graph / Outlook (app registration + clinic mailbox UPN)
# Client credentials (app-only) OR set MS_REFRESH_TOKEN for delegated.
# MS_TENANT_ID=
# MS_CLIENT_ID=
# MS_CLIENT_SECRET=
# MS_USER_UPN=clinic@contoso.com
# MS_REFRESH_TOKEN=
# MS_CALENDAR_ID=
