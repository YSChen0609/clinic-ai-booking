# Copy to .env and adjust locally. Do not commit .env.
# Compose reads this file for ${VAR} substitution. It is not mounted into containers.

APP_IMAGE_TAG=0.1.0
APP_PORT=8000
# Host port for Postgres. Change if 5432 is already in use (e.g. 5433).
POSTGRES_PORT=5432
OLLAMA_PORT=11434
# Tool-capable Ollama tag used by create_agent (pull after compose up).
OLLAMA_MODEL=qwen2.5:7b
# GPU: use compose.gpu.yml on a ready NVIDIA host (see host-requirements.md).
# Optional: point app at host Ollama instead of the compose service, e.g.:
# OLLAMA_BASE_URL=http://host.docker.internal:11434

POSTGRES_USER=clinic
POSTGRES_PASSWORD=clinic_dev_change_me
POSTGRES_DB=clinic

TZ=Asia/Taipei

# Signed session cookie (change for anything beyond local demo).
# SESSION_SECRET=replace-me

# Host pytest uses clinic_test on this host/port (Compose app uses hostname `db` instead).
# TEST_DATABASE_URL=postgresql+psycopg://clinic:clinic_dev_change_me@localhost:5432/clinic_test
